      m_Calls: []
  m_text: "To the one who survived,\n\nIf this note has found your hands, then the
    beast has fallen.\n\n<b>Seek the Floating Tree.</b>\nThere, a secret awaits you
    \u2014 one you must learn before taking the next step.\n\nHidden near its roots
    lies a map that will guide you to the place where the great tyrant must fall.\n\nOnly
    then may peace return to this island."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
