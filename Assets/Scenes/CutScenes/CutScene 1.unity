--- !u!114 &1636431521
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1636431519}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1c5a5ef7c9bbf49ceb7f07677676af51, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroVillageCutsceneController
  director: {fileID: 1636431522}
  subtitleGroup: {fileID: 513982446}
  subtitleText: {fileID: 1087832528}
  fadeGroup: {fileID: 1404175142}
  openingFadeDuration: 1.5
  closingFadeStart: 38
  closingFadeEnd: 40
  subtitles:
  - start: 0.6
    end: 7.7
    speaker: 
    text: Astra Eden. A land where humans and dinosaurs have lived together for generations.
  - start: 8.2
    end: 12.7
    speaker: 
    text: We hunted, explored, and survived together.
  - start: 12.9
    end: 17.6
    speaker: 
    text: Neither humans nor dinosaurs lived alone.
  - start: 18.2
    end: 21.8
    speaker: 
    text: But for us, the world ended at the horizon.
  - start: 21.9
    end: 25.8
    speaker: 
    text: We knew Astra Eden... but little of what existed beyond the sea.
  - start: 26.2
    end: 28.8
    speaker: VILLAGE LEADER
    text: Today, it is your turn.
  - start: 28.9
    end: 31.8
    speaker: VILLAGE LEADER
    text: Go and see what lies beyond our shores.
  - start: 31.9
    end: 35.1
    speaker: VILLAGE LEADER
    text: Find out whether other people live beyond Astra Eden.
  - start: 35.2
    end: 37.8
    speaker: PLAYER
    text: I will return.
  cameraCues:
  - cameraTransform: {fileID: 11408403}
    lookTarget: {fileID: 1961582243}
    start: 0
    end: 8
    startPosition: {x: 8.700012, y: 8.500004, z: -5.6500015}
    endPosition: {x: 2.7000122, y: 6.500004, z: -1.6500015}
  - cameraTransform: {fileID: 200845165}
    lookTarget: {fileID: 956443161}
    start: 8
